From dc605baa69db1b19d14a252a03a718e3ae3485b0 Mon Sep 17 00:00:00 2001
From: Don Gunn <don.gunn@futureelectronics.com>
Date: Mon, 31 Aug 2026 17:00:16 -0700
Subject: [PATCH] updated HDMI driver to prevent using modes with a pixel clock
 higher than 74.25 MHz
Upstream-Status: Pending

---
 drivers/gpu/drm/bridge/imx/imx8mp-hdmi-tx.c | 6 +++++-
 drivers/gpu/drm/imx/dw_hdmi-imx.c           | 8 ++++++--
 2 files changed, 11 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/bridge/imx/imx8mp-hdmi-tx.c b/drivers/gpu/drm/bridge/imx/imx8mp-hdmi-tx.c
index 0e612a8a765e..e5b4553c2de7 100644
--- a/drivers/gpu/drm/bridge/imx/imx8mp-hdmi-tx.c
+++ b/drivers/gpu/drm/bridge/imx/imx8mp-hdmi-tx.c
@@ -28,8 +28,12 @@ imx8mp_hdmi_mode_valid(struct dw_hdmi *dw_hdmi, void *data,
 	if (mode->clock < 13500)
 		return MODE_CLOCK_LOW;
 
-	if (mode->clock > 297000)
+	if (mode->clock > 74250) {
+//		dev_dbg(hdmi->dev,
+//                	"In HDMI_TX Rejecting HDMI mode %s: pixel clock %d kHz > 74250 kHz\n",
+//                	mode->name, mode->clock);
 		return MODE_CLOCK_HIGH;
+	}
 
 	round_rate = clk_round_rate(hdmi->pixclk, mode->clock * 1000);
 	/* imx8mp's pixel clock generator (fsl-samsung-hdmi) cannot generate
diff --git a/drivers/gpu/drm/imx/dw_hdmi-imx.c b/drivers/gpu/drm/imx/dw_hdmi-imx.c
index 483e79ecfd69..f51291379812 100644
--- a/drivers/gpu/drm/imx/dw_hdmi-imx.c
+++ b/drivers/gpu/drm/imx/dw_hdmi-imx.c
@@ -204,9 +204,13 @@ imx8mp_hdmi_mode_valid(struct dw_hdmi *hdmi, void *data,
 
 	if (mode->clock < 13500)
 		return MODE_CLOCK_LOW;
-	if (mode->clock > 297000)
+	if (mode->clock > 297000) {
+//		dev_dbg(hdmi->dev,
+//                	"In HDMI_IMX Rejecting HDMI mode %s: pixel clock %d kHz > 74250 kHz\n",
+//                	mode->name, mode->clock);
 		return MODE_CLOCK_HIGH;
-
+	}
+	
 	if (!imx8mp_hdmi_check_clk_rate(imx_hdmi, mode->clock))
 		return MODE_CLOCK_RANGE;
 
-- 
2.43.0

